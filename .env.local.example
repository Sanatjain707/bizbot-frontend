# Copy this file to .env.local and fill in your values

# Supabase — use the ANON key (not service key)
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Your backend URL
# Local dev:  http://localhost:3000
# Production: https://your-app.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3000

# Your business ID from Supabase businesses table
# After running schema.sql and inserting your business, copy the UUID here
NEXT_PUBLIC_BUSINESS_ID=REPLACE_WITH_YOUR_BUSINESS_UUID
